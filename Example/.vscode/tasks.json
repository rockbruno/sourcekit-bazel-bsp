{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build HelloWorld",
      "type": "shell",
      "command": "bazelisk",
      "args": [
        "build",
        "//HelloWorld"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        {
          "owner": "swift",
          "source": "swift",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        },
      ],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Test HelloWorldTests",
      "type": "shell",
      "command": "bazelisk",
      "args": [
        "test",
        "//HelloWorld:HelloWorldTests"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        {
          "owner": "swift",
          "source": "swift",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        },
      ],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Launch and Debug HelloWorld",
      "type": "shell",
      "command": "./scripts/launch_and_debug.sh",
      "options": {
        "env": {
          "BAZEL_LABEL_TO_RUN": "//HelloWorld:HelloWorld"
        }
      },
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": [
        {
          "owner": "swift",
          "source": "swift",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        },
      ],
      "runOptions": {
        "instanceLimit": 1,
      }
    }
  ]
}
